<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_rainbow"
    android:paddingTop="16dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="History 📋"
        android:textSize="26sp"
        android:fontFamily="sans-serif-black"
        android:textColor="@android:color/white"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="All your transactions"
        android:textSize="13sp"
        android:textColor="@color/colorOnSurfaceVariant"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="12dp" />

    <!-- Glass Search Bar Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/colorOutline"
        app:cardCornerRadius="50dp"
        app:cardBackgroundColor="@color/colorSurface">

        <androidx.appcompat.widget.SearchView
            android:id="@+id/search_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:queryHint="Search expenses..."
            app:iconifiedByDefault="false"
            app:searchIcon="@android:drawable/ic_menu_search"
            app:closeIcon="@android:drawable/ic_menu_close_clear_cancel"
            android:background="@android:color/transparent" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Month Filter -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Filter by Month"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="14dp"
        style="@style/Widget.App.TextInput.Glass"
        app:startIconDrawable="@android:drawable/ic_menu_my_calendar"
        app:startIconTint="@color/colorPrimary">

        <AutoCompleteTextView
            android:id="@+id/spinner_month"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/colorOnSurface"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Empty State -->
    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="40dp"
        android:text="✦ No expenses found"
        android:textColor="@color/colorOnSurfaceVariant"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- Expense List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_expenses"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingBottom="16dp"
        android:clipToPadding="false" />

</LinearLayout>

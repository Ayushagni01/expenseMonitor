<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_rainbow">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monthly Report 📄"
            android:textSize="26sp"
            android:fontFamily="sans-serif-black"
            android:textColor="@android:color/white"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your financial snapshot"
            android:textSize="13sp"
            android:textColor="@color/colorOnSurfaceVariant"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="20dp" />

        <!-- Month Navigation -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/colorOutline"
            app:cardCornerRadius="50dp"
            app:cardBackgroundColor="@color/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <Button
                    android:id="@+id/btn_prev_month"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/btn_rainbow_tonal"
                    android:backgroundTint="@null"
                    android:text="&lt;"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_current_month"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="March 2026"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="@color/colorOnSurface" />

                <Button
                    android:id="@+id/btn_next_month"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/btn_rainbow_tonal"
                    android:backgroundTint="@null"
                    android:text="&gt;"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Summary Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/colorOutline"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="@color/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SUMMARY"
                    android:textSize="10sp"
                    android:letterSpacing="0.2"
                    android:textColor="@color/colorPrimary"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="16dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="12dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Monthly Salary" android:textColor="@color/colorOnSurfaceVariant"
                        android:textSize="14sp" />
                    <TextView android:id="@+id/tv_salary" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:fontFamily="sans-serif-bold"
                        android:textColor="@color/colorIncome" android:textSize="14sp" android:text="₹ 0.00" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="12dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Total Spent" android:textColor="@color/colorOnSurfaceVariant"
                        android:textSize="14sp" />
                    <TextView android:id="@+id/tv_total_spent" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:fontFamily="sans-serif-bold"
                        android:textColor="@color/colorExpense" android:textSize="14sp" android:text="₹ 0.00" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="12dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Balance" android:textColor="@color/colorOnSurfaceVariant"
                        android:textSize="14sp" />
                    <TextView android:id="@+id/tv_balance" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:fontFamily="sans-serif-bold"
                        android:textColor="@color/colorIncome" android:textSize="14sp" android:text="₹ 0.00" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Transactions" android:textColor="@color/colorOnSurfaceVariant"
                        android:textSize="14sp" />
                    <TextView android:id="@+id/tv_transaction_count" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:fontFamily="sans-serif-bold"
                        android:textColor="@color/colorOnSurface" android:textSize="14sp" android:text="0" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Category Breakdown Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/colorOutline"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="@color/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CATEGORY BREAKDOWN"
                    android:textSize="10sp"
                    android:letterSpacing="0.2"
                    android:textColor="@color/colorSecondary"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tv_category_breakdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No expenses this month"
                    android:lineSpacingMultiplier="1.6"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:indeterminateTint="@color/colorPrimary"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_generate_pdf"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_rainbow"
            android:backgroundTint="@null"
            android:text="✦  Generate PDF Report"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="15sp" />

    </LinearLayout>
</ScrollView>

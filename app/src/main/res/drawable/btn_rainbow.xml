<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#CC6D28D9"
                android:endColor="#CC4338CA" />
            <corners android:radius="50dp" />
        </shape>
    </item>
    <!-- Focused -->
    <item android:state_focused="true">
        <shape>
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#7C3AED"
                android:endColor="#4F46E5" />
            <corners android:radius="50dp" />
            <stroke android:width="2dp" android:color="#AAFFFFFF" />
        </shape>
    </item>
    <!-- Default: Rich violet → indigo -->
    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#7C3AED"
                android:centerColor="#5B56EF"
                android:endColor="#4F46E5" />
            <corners android:radius="50dp" />
        </shape>
    </item>
</selector>
